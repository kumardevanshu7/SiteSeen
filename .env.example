# =============================================================================
# SiteSeen — environment template
# =============================================================================
# LOCAL:  copy to `.env.local` and fill values. Never commit `.env.local`.
# VERCEL: Project → Settings → Environment Variables — add the SAME keys
#         manually (Production + Preview). Do NOT upload this file to GitHub
#         with real values.
# =============================================================================

# ── Firebase Web SDK (client — NEXT_PUBLIC_* is exposed to the browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── One Password session HMAC (server-only, min 16 random chars) ─────────
ONE_PASSWORD_UNLOCK_SECRET=

# ── Firebase Admin SDK (server-only — required on Vercel) ────────────────
# Option A (recommended for Vercel): paste the FULL service account JSON
# as a single-line string. Escape newlines inside private_key as \n.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: split fields instead of full JSON
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Local only (ignored by git) ──────────────────────────────────────────
# Place the downloaded service account file at:
#   scripts/serviceAccountKey.json
# Used automatically in local/dev when env vars above are empty.
