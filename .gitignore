# ── Dependencies ──────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js / build ───────────────────────────────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ── Env & secrets (NEVER commit) ──────────────────────────────
# Local + Vercel values stay off GitHub — set them in Vercel Dashboard.
.env
.env.*
!.env.example

# Firebase Admin / Google Cloud credentials
scripts/serviceAccountKey.json
**/serviceAccountKey.json
**/firebase-adminsdk*.json
*-firebase-adminsdk-*.json
**/google-services.json
**/GoogleService-Info.plist

# Keys, certs, tokens
*.pem
*.p12
*.key
*.crt
*.cer
*.pfx
id_rsa*
*.secret
credentials.json
**/secrets/**

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ── Debug / logs ──────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── Testing / coverage ────────────────────────────────────────
/coverage
.nyc_output

# ── Vercel ────────────────────────────────────────────────────
.vercel

# ── Misc local junk ───────────────────────────────────────────
*.local
.turbo
